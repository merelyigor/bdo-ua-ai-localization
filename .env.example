# Зразок. `.env` створюється сам під час першого запуску, ключі вставляються на екрані «підключення».
# `.env` під .gitignore; значення в чат, логи й git не потрапляють.

# Ціль і дозвіл запису: DEV або PROD. Перемикач · кнопки на «Старті».
BDO_ENV=PROD

# BDO UA Translate Agent API
# Адреси публічні й уже є в коді; рядки потрібні лише для перевизначення.
BDO_API_BASE_DEV=https://bdo-ua.dev/api/agent/v1
BDO_API_KEY_DEV=
BDO_API_BASE_PROD=https://bdo-ua.com.ua/api/agent/v1
BDO_API_KEY_PROD=

# Локальні рантайми моделей · адреси змінюються на екрані «підключення».
OLLAMA_ENDPOINT=http://127.0.0.1:11434
OMLX_ENDPOINT=http://127.0.0.1:18080/v1
LLAMASWAP_ENDPOINT=http://127.0.0.1:18081/v1

# Адреси й ключі провайдерів можна змінити кнопками екрана «Моделі».
OPENAI_COMPAT_ENDPOINT=
OPENAI_COMPAT_API_KEY=
# Підписка OpenCode Go (провайдер go, D-40). Для слотів 2–10 додай лише потрібні.
OPENCODE_API_KEY=
# OPENCODE_API_KEY_2=
# OPENCODE_API_KEY_3=
# OPENCODE_API_KEY_4=
# OPENCODE_API_KEY_5=
# OPENCODE_API_KEY_6=
# OPENCODE_API_KEY_7=
# OPENCODE_API_KEY_8=
# OPENCODE_API_KEY_9=
# OPENCODE_API_KEY_10=
OPENCODE_API_KEY_ACTIVE=1
# Ключ oMLX · на екрані «підключення».
OMLX_API_KEY=

# Веб-інтерфейс
BDO_WEB_PORT=7660
