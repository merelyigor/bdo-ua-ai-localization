# Безпечний публічний шаблон. Значення ключів завжди порожні.
# Реальні ключі та інші чутливі значення зберігаються лише в `.env`, який Git
# ігнорує. Не вставляйте їх у команди, документацію, issue, prompts або логи.

# --- Мінімум, щоб почати ------------------------------------------------------
#
# Два рядки. Ціль прогону і ключ до неї.
#
# BDO_ENV задає середовище для ЧИТАННЯ і для ЗАПИСУ одночасно. Це єдине місце,
# де ціль оголошується: ні промпт, ні команда її не обирають і не перемикають.
# Перемикання середовища · правка ОДНОГО рядка, без правки адрес.
#
# PROD означає бойову базу гравців. Запис туди лишається дією, на яку власник
# дає окреме підтвердження в діалозі, навіть коли BDO_ENV=PROD.
BDO_ENV=PROD
BDO_API_KEY_PROD=

# --- Адреси API: у коді, не тут -----------------------------------------------
#
# Адреса production Agent API · публічна константа, зашита в
# `cli/system/select-env.sh`. Реальне значення нижче наведене як явний приклад;
# для звичайної роботи його можна не розкоментовувати.
#
# Перебивати адресу потрібно лише при self-hosting або роботі проти дзеркала:
#
# BDO_API_BASE_PROD=https://bdo-ua.com.ua/api/agent/v1
# BDO_API_BASE=https://bdo-ua.dev/api/agent/v1  (напряму, незалежно від BDO_ENV)

# --- Для розробки самого проєкту ----------------------------------------------
#
# BDO_ENV=DEV призначений тим, хто розробляє BDO UA Translate, а не перекладає.
# Адреса того середовища · приватна інфраструктура, тому дефолта в коді вона не
# має і задається лише тут. Публічним користувачам цей блок не потрібен.
#
# BDO_ENV=DEV
# BDO_API_BASE_DEV=https://bdo-ua.dev/api/agent/v1
# BDO_API_KEY_DEV=

# --- Пов'язаний проєкт: де живе сайт, API і вся серверна логіка ---------------
#
# Цей репозиторій · КЛІЄНТ. У ньому немає БД, вебзастосунку, адмінки, черги
# модерації й самого API: він лише читає й пише через Agent API. Уся серверна
# логіка (Laravel-застосунок BDO UA Translate, схема БД, глосарій, модерація,
# сторінки патчів, документація API) живе в ОКРЕМОМУ проєкті.
#
# TRANSLATE_PROJECT_ROOT · необовʼязковий повний локальний шлях до кореня
# серверного проєкту. Додавайте його лише адміністратори, які мають цей проєкт
# локально доступним. Для типової роботи перекладача він не потрібен.
#
# Що там лежить корисного (шляхи від цього кореня):
#   docs/AGENT_TRANSLATION_API.md   повний контракт Agent API: ендпоінти, коди помилок
#   app/                            логіка шарів, глосарію, модерації, валідації
#   routes/                         маршрути, включно з /api/agent/v1
#
# Правила: звідси проєкт лише ЧИТАЄТЬСЯ. Не редагувати, не дублювати його код і
# не комітити цей шлях у публічний репозиторій · він локальний і в `.env.example`
# лишається прикладом. Автопошук знаходить корінь за файлом `artisan` на рівень
# вище; якщо набір лежить окремо, задайте шлях вручну.
#
# TRANSLATE_PROJECT_ROOT=/шлях/до/папки-де-проект/www/bdo_ua_translate/public
#
# Публічний сайт і адмінка того ж проєкту · https://bdo-ua.com.ua

# --- Розкладка на диску (усі змінні необовʼязкові) ---------------------------
#
# Необовʼязкова безпечна ротація після успішної пачки. Видаляються лише пачки
# зі станом verified та старі output; активна пачка, quarantine і write-log
# ніколи не видаляються. Без цього прапорця ./bdo clean лишається ручним.
# BDO_AUTO_CLEAN=1
# BDO_KEEP_DAYS=14
#
# Профіль моделей child-агентів. Основна модель OpenCode не змінюється.
# Після зміни достатньо нової команди ./bdo env або нової OpenCode-сесії.
# TRANSLATE_MODEL_PROFILE=session-free
#
# Набір скриптів сам знаходить промпти субагентів і конфіг OpenCode: спочатку
# поруч із собою, потім на рівень вище. Задавати щось потрібно лише тоді, коли
# автопошук не влучає · наприклад набір лежить окремим репозиторієм, а обидва
# каталоги не в очікуваних місцях. Що вирішилось, показує `./bdo paths`.
#
# TRANSLATE_AGENTS_DIR=/шлях/до/.opencode/agents
# TRANSLATE_OPENCODE_CONFIG=/шлях/до/opencode.json
# TRANSLATE_AGENT_VALIDATOR=/шлях/до/.opencode/validate-translation-agents.sh
#
# Файл із ключами поза каталогом набору.
# TRANSLATE_ENV_FILE=/шлях/до/.env
