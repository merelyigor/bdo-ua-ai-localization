# Публічний шаблон локального `.env`.
# Реальні ключі, приватні адреси й персональні шляхи зберігайте лише в `.env`.

# =============================================================================
# 1. ЦІЛЬ І ДОСТУП ДО API
# =============================================================================

# Єдина ціль читання і запису: PROD або DEV.
# Для PROD запис іде в бойову базу; перед першою пачкою агент оголошує ціль.
BDO_ENV=PROD

# Ключ активного середовища. Другий ключ потрібен лише коли використовуєте DEV.
BDO_API_KEY_PROD=
# BDO_API_KEY_DEV=

# Публічний production endpoint за замовчуванням зашитий у select-env.sh.
# Ці змінні потрібні лише для self-hosting, дзеркала або прямого override.
# BDO_API_BASE_PROD=https://bdo-ua.com.ua/api/agent/v1
# BDO_API_BASE=https://bdo-ua.dev/api/agent/v1

# =============================================================================
# 2. ПРОФІЛЬ МОДЕЛЕЙ CHILD-АГЕНТІВ
# =============================================================================

# Допустимі значення — лише:
#   session-free  · OpenCode Zen: opencode/x-preview-f-free (безплатний маршрут)
#   local-fast    · Ollama: ollama-local/qwen3.5:9b (швидкий локальний профіль)
#   local-quality · Ollama: ollama-local/qwen3.6:35b-a3b-mtp-q4_K_M (якісний
#                    локальний профіль; модель має бути встановлена в Ollama)
# Профіль стосується всіх translation-* child-агентів, але не основної моделі.
# Після зміни виконайте ./bdo env або відкрийте нову OpenCode-сесію.
TRANSLATE_MODEL_PROFILE=session-free

# Необовʼязковий override моделі активного профілю.
# Порожнє значення використовує штатний маршрут профілю. Якщо вказати модель,
# усі child-агенти активного профілю використовують саме її.
# Якщо child спробує іншу модель, native Task буде зупинено з помилкою до генерації.
# Формат: provider/model-id. Для платної моделі окремо вкажіть paid; профілі,
# де платні маршрути заборонені, її відхилять.
# OpenCode Zen catalog, перевірено 2026-08-23. Копіюйте повний ID після `=`:
# Безплатні:
#   opencode/x-preview-f-free - Ox Alpha Free Unlimited
#   opencode/muse-spark-1.2-contributor-free
#   opencode/mimo-v2.5-free
#   opencode/hy3-free
#   opencode/nemotron-3-ultra-free
#   opencode/nemotron-3.5-lightning-free
#   opencode/laguna-s-2.1-free
# Платні моделі тут навмисно не перелічені: child-агенти працюють лише
# з безплатними маршрутами.
# Повний актуальний список у OpenCode: `/models`, або:
#   curl -fsSL https://opencode.ai/zen/v1/models | jq -r '.data[].id'
TRANSLATE_MODEL=
TRANSLATE_MODEL_COST=free

# =============================================================================
# 3. ЛОКАЛЬНЕ СХОВИЩЕ І РОТАЦІЯ
# =============================================================================

# Необовʼязкова автоматична ротація після успішної пачки.
# Видаляються лише старі verified-пачки та output; активні й quarantine дані
# не видаляються. Без прапорця ./bdo clean лишається ручним.
# BDO_AUTO_CLEAN=1
# BDO_KEEP_DAYS=14

# =============================================================================
# 4. ПОВʼЯЗАНИЙ СЕРВЕРНИЙ ПРОЄКТ (ТІЛЬКИ ДЛЯ АДМІНІСТРАТОРІВ)
# =============================================================================

# Цей toolkit — лише клієнт Agent API. Сервер, БД, модерація і глосарій живуть
# в окремому проєкті. Змінна не потрібна для звичайного перекладу.
# Додавайте її лише якщо серверний проєкт доступний локально адміністратору.
# TRANSLATE_PROJECT_ROOT=/шлях/до/папки-де-проект/www/bdo_ua_translate/public

# =============================================================================
# 5. НЕОБОВʼЯЗКОВІ ШЛЯХИ АВТОПОШУКУ
# =============================================================================

# Набір сам знаходить ці каталоги поруч із собою або на рівень вище.
# Задавайте змінні лише якщо автопошук не влучає. Результат: ./bdo paths.
# TRANSLATE_AGENTS_DIR=/шлях/до/.opencode/agents
# TRANSLATE_OPENCODE_CONFIG=/шлях/до/opencode.json
# TRANSLATE_AGENT_VALIDATOR=/шлях/до/.opencode/validate-translation-agents.sh

# Файл із ключами поза каталогом набору, якщо він має інше розташування.
# TRANSLATE_ENV_FILE=/шлях/до/.env
