# Публічний шаблон локального `.env` і ЄДИНЕ місце пояснень до змінних.
# Реальні ключі, приватні адреси й персональні шляхи зберігайте лише в `.env`.
# Швидкий старт без зайвого · `.env.minimal.example`.

# =============================================================================
# 1. ЦІЛЬ І ДОСТУП ДО API
# =============================================================================

# Єдина ціль читання і запису: PROD або DEV.
# Для PROD запис іде в бойову базу; перед першою пачкою агент оголошує ціль.
BDO_ENV=PROD

# Ключ активного середовища. Другий ключ потрібен лише коли використовуєте DEV.
BDO_API_KEY_PROD=
BDO_API_KEY_DEV=

# PROD має публічний default нижче; override потрібен лише для дзеркала.
# DEV не має публічної адреси й вимагає окремий локальний URL.
# BDO_API_BASE_PROD=https://bdo-ua.com.ua/api/agent/v1
# BDO_API_BASE_DEV=https://your-private-dev.example/api/agent/v1
# Застарілий BDO_API_BASE навмисно ігнорується: BDO_ENV жорстко визначає ціль.

# =============================================================================
# 2. ПРОФІЛЬ МОДЕЛЕЙ CHILD-АГЕНТІВ
# =============================================================================

# Профіль задає МОДЕЛІ child-агентів (не основної моделі-диригента).
# Вбудовані:
#   session-free  · OpenCode Zen: opencode/big-pickle (безплатний)
#   session-go    · OpenCode Go: opencode-go/ox-alpha-free (платна підписка)
#   session-luna  · openai/gpt-5.6-luna (ПЛАТНИЙ, ~$0.2/1M вх. і $1.2/1M вих.)
#   ollama-local  · локальна Ollama; конкретну модель задає TRANSLATE_MODEL
#                    нижче, типова · ollama-local/qwen3.6:35b-a3b-mtp-q4_K_M.
#                    Модель має бути встановлена в Ollama (`ollama list`).
# Після зміни `.env` повідомте primary «продовжуй»: він сам виконає ./bdo env
# і за потреби попросить перезапустити OpenCode.
# Команда атомарно створює ignored runtime-конфіги з tracked-шаблонів; ваш
# профіль не змінює файли Git і не може перезаписати публічний канон.
# Якщо effective profile/model змінився у вже відкритому OpenCode, автоматика
# заблокує child до витрати токенів і primary попросить перезапустити OpenCode.
# Перелік і поточні маршрути: ./bdo profile status
TRANSLATE_MODEL_PROFILE=session-free

# Необовʼязковий override моделі активного профілю.
# Порожнє значення використовує штатний маршрут профілю. Якщо вказати модель,
# усі child-агенти активного профілю використовують саме її.
# Якщо child спробує іншу модель, native Task буде зупинено з помилкою до генерації.
# Формат: provider/model-id. Платна модель вимагає TRANSLATE_MODEL_COST=paid І
# профілю з дозволеними платними маршрутами · інакше запуск відхиляється.
#
# ПРИКЛАД · GPT-5.6 Luna як модель субагентів (три рядки разом):
#   TRANSLATE_MODEL_PROFILE=session-luna
#   TRANSLATE_MODEL=openai/gpt-5.6-luna
#   TRANSLATE_MODEL_COST=paid
# Повернутися на безплатний: TRANSLATE_MODEL_PROFILE=session-free,
# TRANSLATE_MODEL=opencode/big-pickle, TRANSLATE_MODEL_COST=free.
#
# OpenCode Go для child-агентів (типовий маршрут · Ox Alpha Free):
#   TRANSLATE_MODEL_PROFILE=session-go
#   TRANSLATE_MODEL=opencode-go/ox-alpha-free
#   TRANSLATE_MODEL_COST=paid
# Альтернативи: opencode-go/mimo-v2.5 (MiMo V2.5),
# opencode-go/mimo-v2.5-pro (MiMo V2.5 Pro),
# opencode-go/muse-spark-1.2-contributor (Muse Spark 1.2 Contributor) або
# opencode-go/hy3 (Hy3). Muse Spark доступний не в усіх регіонах. Потрібна активна підписка
# OpenCode Go; для цих маршрутів немає окремої оплати за токени.
# Доступність і точні назви перевіряйте в OpenCode через `/models`.
#
# УВАГА про вартість. Субагенти роблять усю мовну роботу, тому платна модель
# тут коштує на кожному рядку, а не на пачці: у патчі 1 їх 29927. Прикидка на
# Luna · близько 3-5 тисяч токенів на пачку з 15 рядків, тобто одиниці доларів
# на тисячу пачок. Для разової якісної перевірки це дешево, для суцільного
# прогону цілого патча · рахуйте заздалегідь.
#
# OpenCode Zen catalog, перевірено 2026-08-23. Копіюйте повний ID після `=`:
# Безплатні:
#   opencode/big-pickle - Big Pickle (безплатний)
#   opencode/muse-spark-1.2-contributor-free
#   opencode/mimo-v2.5-free
#   opencode/hy3-free
#   opencode/nemotron-3-ultra-free
#   opencode/nemotron-3.5-lightning-free
#   opencode/laguna-s-2.1-free
# OpenCode Go (платна підписка; `COST=paid` потрібен для явного дозволу):
#   opencode-go/ox-alpha-free - Ox Alpha Free
#   opencode-go/mimo-v2.5 - MiMo V2.5
#   opencode-go/mimo-v2.5-pro - MiMo V2.5 Pro
#   opencode-go/muse-spark-1.2-contributor - Muse Spark 1.2 Contributor
#   opencode-go/hy3 - Hy3
# Локальні (профіль ollama-local; без оплати за токени):
#   ollama-local/qwen3.6:35b-a3b-mtp-q4_K_M (типова локальна · 22 ГБ, ~56 tok/s)
#   ollama-local/qwen3.8:27b (dense 27B · утричі повільніша, більше русизмів)
#   ollama-local/qwen3.5:9b (легка · для smoke і слабкого заліза)
# Повний актуальний список у OpenCode: `/models`, або:
#   curl -fsSL https://opencode.ai/zen/v1/models | jq -r '.data[].id'
TRANSLATE_MODEL=opencode/big-pickle
TRANSLATE_MODEL_COST=free

# Роздуми (reasoning) child-агентів. Стосується лише translation-* child;
# основної моделі не торкається.
#   none                типово · роздуми вимкнені, весь бюджет іде у відповідь
#   off                 нічого не надсилати, лишити дефолт провайдера
#   minimal|low|medium|high   якщо конкретній моделі роздуми справді потрібні
# Навіщо: відповідь child · один JSON зі staged payload, і роздуми над ним
# коштують токенів, а на Ollama колись з'їдали весь вихід, лишаючи порожній
# `content`. Перевірити фактичний результат: ./bdo audit (позначка THINK).
# Якщо модель не вміє вказаного рівня (наприклад, у каталозі Big Pickle немає
# переліку effort), надсилається безпечний fallback · значення
# повз перелік моделі не йде. Повністю вимкнути роздуми вдається не на кожній
# моделі: на Ollama так, на Zen-моделях із обовʼязковим reasoning · ні.
# GPT-5.6 Luna оголошує none|low|medium|high|xhigh|max, тому для неї працюють
# обидва потрібні режими: `none` (типово) і `low`, якщо схочете більше якості
# ціною токенів · саме ті значення, що видно в перемикачі OpenCode.
BDO_REASONING_EFFORT=off

# Retry native child-агента після тимчасової помилки провайдера.
# Коротке retry-вікно керує лише експоненційним backoff між native Task:
# 600 секунд = 10 хвилин, пауза між спробами не більша за 60 секунд.
# Після нього driver сам відкриває наступне вікно для ТІЄЇ САМОЇ пачки;
# primary не просить власника писати «продовжуй».
BDO_CHILD_RETRY_WINDOW_SECONDS=600
# Загальний збережений бюджет недоступності провайдера для однієї ролі пачки.
# 86400 = 24 години. Лише після нього flow чесно зупиняється з
# `child_retry_budget_exhausted`; пачка й payload лишаються для відновлення.
BDO_CHILD_RETRY_TOTAL_SECONDS=86400

# Скільки разів поспіль субагент може не повернути НІЧОГО, перш ніж прогін
# зупиниться з `child_no_response`. Типово 3.
#
# «Нічого» тут означає буквально: ні файла відповіді, ні запису в
# `state/child-incidents.json`. Зіпсована відповідь інцидент лишає, тому під це
# правило не підпадає й лікується звичайним повтором. А порожня дитяча сесія з
# нулем токенів · це майже завжди відмова провайдера або несумісна модель, і
# чекати на неї добу немає сенсу: двічі (2026-08-20 і 2026-08-27) це коштувало
# годин розбору, бо виглядало як «падає модель».
# BDO_CHILD_SILENT_LIMIT=3

# Скільки ПАЧОК дозволено одному прогону. Не рядків · саме пачок.
#
# Порахувати просто: ця цифра помножена на розмір пачки. За розміру 50 і
# значення 1000 один прогін закриє до 50 000 рядків, і лише потім `mode start`
# поверне `budget_exhausted`, тобто попросить почати новий прогін.
#   25   -> 1 250 рядків за прогін (старий дефолт; на великому патчі це ~750 зупинок)
#   1000 -> 50 000 рядків за прогін
#
# Навіщо стеля взагалі існує: це запобіжник проти нескінченного кола, якщо
# вибірка почне віддавати ті самі рядки. Вона НЕ економить токени й нічого не
# оптимізує · лише обмежує, скільки пачок мовчки піде поспіль.
# BDO_RUN_MAX_BATCHES=25

# Скільки кіл лікування проходить один рядок перед відправкою до людини.
# BDO_HEAL_MAX_ATTEMPTS=1

# Endpoint локальної Ollama для профілів local-* і `./bdo bench`.
# BDO_OLLAMA_URL=http://127.0.0.1:11434

# Повне трасування помилок PHP у виводі команд. Лише для розбору збою.
# BDO_DEBUG=1

# Суддя спірних рядків (`translation-judge`).
#   BDO_JUDGE=off             вимкнути суддю; маршрут вирішує канал, як раніше
#   BDO_JUDGE_MIN_CONFIDENCE  ціле число 1-100, типово 65
# Суддя викликається ЛИШЕ за наявності спірних рядків і вирішує лише МАРШРУТ
# (у ШІ-шар як є чи до людини в модерацію), тексту він не торкається. Механічні
# дефекти вище нього: зламаний токен, довжина, гомогліф чи русизм ведуть рядок
# до людини попри будь-який відсоток. Нижче значення = більше рядків у ШІ-шарі;
# вище = більше ручної модерації. Невалідне/порожнє значення повертає типовий 65.
# Калібрування: ./bdo judge
# BDO_JUDGE=off
BDO_JUDGE_MIN_CONFIDENCE=65

# =============================================================================
# 3. WINDOWS: OPENCODE ПОЗА WSL
# =============================================================================

# Ці дві змінні потрібні ЛИШЕ на Windows, коли OpenCode запущений як native
# застосунок, а сам набір живе у WSL2. На macOS, Linux і всередині WSL нічого
# задавати не треба.

# Через що виконувати `./bdo`.
#   auto  типово · Windows -> WSL, решта платформ -> напряму
#   wsl   примусово через `wsl.exe --cd <шлях> bash -lc ...`
#   off   аварійний вихід: виконувати напряму навіть на Windows
# Перепис робить guard уже ПІСЛЯ перевірки команди, тому дозволений перелік
# лишається той самий.
# BDO_SHELL_BRIDGE=auto

# Домівка користувача, у якій OpenCode тримає свої дані.
# Потрібна тому, що з WSL `$HOME` це `/home/<user>`, а native OpenCode пише в
# профіль Windows. Без неї ./bdo audit, audit-dump і models не бачать бази
# сесій · тобто зникає єдине джерело правди про субагентів.
# BDO_OPENCODE_HOME=/mnt/c/Users/<user>

# =============================================================================
# 4. ЛОКАЛЬНЕ СХОВИЩЕ І РОТАЦІЯ
# =============================================================================

# Автоматичне прибирання після кожної завершеної пачки. УВІМКНЕНЕ за
# замовчуванням: флоу прибирає за собою сам, а `0` лишається аварійним
# вимикачем на час розбору збою, коли похідні файли ще потрібні.
#
# Правило одне й доказове: тека пачки, на яку не вказує `state/current-batch`,
# недосяжна для флоу, тому її похідні файли (дампи API, payload, кандидати)
# видаляються, а квитанція (`manifest.json`, `journal.jsonl`,
# `batch-summary.json`) лишається. Поточна пачка не чіпається ніколи.
# Карантин, `write-log.jsonl` і живий стан прогону не чіпаються ніколи.
# BDO_AUTO_CLEAN=0

# Скільки квитанцій завершених пачок тримати. ~2,5 КБ кожна.
# BDO_KEEP_RECEIPTS=50

# Через скільки днів прибирати дампи API в `output/`.
BDO_KEEP_DAYS=14

# =============================================================================
# 5. ПОВʼЯЗАНИЙ СЕРВЕРНИЙ ПРОЄКТ (ТІЛЬКИ ДЛЯ АДМІНІСТРАТОРІВ)
# =============================================================================

# Цей toolkit — лише клієнт Agent API. Сервер, БД, модерація і глосарій живуть
# в окремому проєкті. Змінна не потрібна для звичайного перекладу.
# Додавайте її лише якщо серверний проєкт доступний локально адміністратору.
TRANSLATE_PROJECT_ROOT=/шлях/до/папки-де-проект/www/bdo_ua_translate/public

# =============================================================================
# 6. НЕОБОВʼЯЗКОВІ ШЛЯХИ АВТОПОШУКУ
# =============================================================================

# Набір сам знаходить tracked-шаблони та локальний generated/ignored runtime
# поруч із собою або на рівень вище.
# Задавайте змінні лише якщо автопошук не влучає. Результат: ./bdo paths.
# Указані нижче override-и стосуються саме локальних generated/ignored файлів.
# TRANSLATE_AGENTS_DIR=/шлях/до/.opencode/agents
# TRANSLATE_OPENCODE_CONFIG=/шлях/до/opencode.json
# TRANSLATE_AGENT_VALIDATOR=/шлях/до/.opencode/validate-translation-agents.sh

# Файл із ключами поза каталогом набору, якщо він має інше розташування.
# TRANSLATE_ENV_FILE=/шлях/до/.env
