# Публічний шаблон локального `.env` і ЄДИНЕ місце пояснень до змінних.
# Реальні ключі, приватні адреси й персональні шляхи зберігайте лише в `.env`.
# Швидкий старт без зайвого · `.env.minimal.example`.
#
# Модель тут НЕ задається: за неї відповідає `config/roles.json`, де лежать
# `default_model`, `endpoint`, `num_ctx` і, за потреби, окрема модель ролі.
# Причина переїзду: модель мусить бути там само, де промпт і схема ролі,
# інакше `.env` каже одне, а працює інше · саме так 2026-08-15 мовчки впали
# чотири виклики поспіль.

# =============================================================================
# 1. ЦІЛЬ І ДОСТУП ДО API
# =============================================================================

# PROD | DEV · єдина ціль читання і запису. Що стоїть зараз: ./bdo env
BDO_ENV=PROD

# Ключ активного середовища. Другий потрібен лише якщо використовуєте DEV.
# Ключ у публічний репозиторій не потрапляє: `.env` ігнорується Git-ом, а
# pre-commit hook додатково шукає його значення у застейдженому вмісті.
BDO_API_KEY_PROD=
BDO_API_KEY_DEV=

# Override адреси потрібен лише для дзеркала; PROD має вбудований default.
# BDO_API_BASE_PROD=https://bdo-ua.com.ua/api/agent/v1

# Корінь обслуговуваного проєкту · read-only довідник контракту.
# TRANSLATE_PROJECT_ROOT=/шлях/до/серверного/проєкту   # read-only довідник контракту

# =============================================================================
# 2. МОДЕЛІ
# =============================================================================

# Модель, схему й температуру кожної ролі задає `config/roles.json`.
# Тут лишається тільки адреса Ollama, і лише якщо вона не типова.
# OLLAMA_URL=http://127.0.0.1:11434

# =============================================================================
# 3. ОБСЯГ PAYLOAD
# =============================================================================

# Скільки прикладів і термінів класти у спільний блок payload.
BDO_SHARED_EXAMPLES=12
BDO_EXAMPLES_BUDGET=4000
BDO_CONCEPTS_MAX=25
BDO_CONCEPTS_TTL_HOURS=24

# =============================================================================
# 4. ПРОГІН
# =============================================================================

# Стеля пачок на один прогін · запобіжник від нескінченного циклу.
BDO_RUN_MAX_BATCHES=1000

# Мінімальна впевненість судді, нижче якої рядок іде до людини.
BDO_JUDGE_MIN_CONFIDENCE=65

# Скільки разів драйвер повторює крок, який не рухає стан.
# BDO_LOOP_SPIN_LIMIT=12

# Вікно й загальний бюджет повторів кроку, який не дав відповіді.
BDO_CHILD_RETRY_WINDOW_SECONDS=600
BDO_CHILD_RETRY_TOTAL_SECONDS=86400

# Межа робочої сесії у хвилинах для `./bdo timer`.
# BDO_SESSION_BUDGET_MINUTES=300

# Підказки про розмір сесії.
BDO_SESSION_HINT_BATCHES=2
BDO_SESSION_HINT_BYTES=300000

# =============================================================================
# 5. ТЕРМІНИ Й ПРИБИРАННЯ
# =============================================================================

BDO_TERM_NOTES_AUTO=on
BDO_TERM_NOTES_MIN_QUEUE=5
BDO_TERM_NOTES_BATCH=10
BDO_TERM_NOTES_MIN_CONFIDENCE=60
BDO_TERM_NOTES_MAX_SEND=3

BDO_AUTO_CLEAN=1
BDO_KEEP_DAYS=14
