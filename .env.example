# Публічний шаблон локального `.env` і ЄДИНЕ місце пояснень до змінних.
# Реальні ключі, приватні адреси й персональні шляхи зберігайте лише в `.env`.
# Швидкий старт без зайвого · `.env.minimal.example`.
#
# Кожна змінна тут підписана: що вона робить, у яких одиницях і що станеться,
# якщо її не задати. Значення нижче · робочі типові; порожній `.env` із самим
# лише `BDO_ENV` і ключем теж працює.
#
# Модель тут НЕ задається: за неї відповідає `config/roles.json`, де лежать
# `default_model`, `endpoint`, `num_ctx` і, за потреби, окрема модель ролі.
# Причина переїзду: модель мусить бути там само, де промпт і схема ролі,
# інакше `.env` каже одне, а працює інше · саме так 2026-08-15 мовчки впали
# чотири виклики поспіль.

# =============================================================================
# 1. ЦІЛЬ І ДОСТУП ДО API
# =============================================================================

# Куди читати й ПИСАТИ: PROD або DEV. Одна змінна на обидва напрями, щоб
# частина прогону не поїхала в інше середовище. Вона ж є дозволом на запис:
# окремого підтвердження прод-запису набір не питає, свідома дія · правка цього
# рядка. Що стоїть зараз: ./bdo env
BDO_ENV=PROD

# Ключ Agent API. Береться той, що відповідає BDO_ENV; другий потрібен лише
# якщо ви справді користуєтесь DEV.
# У публічний репозиторій ключ не потрапляє: `.env` ігнорується Git-ом, а
# pre-commit hook додатково шукає його значення в застейдженому вмісті.
BDO_API_KEY_PROD=
BDO_API_KEY_DEV=

# Адреса API. PROD має вбудований default у `cli/system/select-env.sh`, тому
# рядок нижче потрібен лише для дзеркала або тестового стенду. DEV публічної
# адреси не має й вимагає власного URL.
# BDO_API_BASE_PROD=https://bdo-ua.com.ua/api/agent/v1
# BDO_API_BASE_DEV=https://your-private-dev.example/api/agent/v1

# Корінь серверного проєкту · ЛИШЕ read-only довідник контракту. Набір нічого
# там не запускає й не змінює; шлях потрібен, щоб звірити контракт із кодом,
# а не з переказу. Без нього все працює, просто така звірка недоступна.
# TRANSLATE_PROJECT_ROOT=/шлях/до/серверного/проєкту

# =============================================================================
# 2. МОДЕЛІ
# =============================================================================

# Модель, схему й температуру кожної ролі задає `config/roles.json`.
# Тут лишається тільки адреса Ollama, і лише якщо вона не типова: наприклад,
# Ollama на іншій машині або на Windows-хості при роботі з WSL.
# Перевірити, що модель на місці й тримає схему: ./bdo runtime
# OLLAMA_URL=http://127.0.0.1:11434

# =============================================================================
# 3. ОБСЯГ PAYLOAD
# =============================================================================
#
# Ці числа керують тим, СКІЛЬКИ контексту бачить модель. Більше · точніший
# переклад, але довша генерація й ризик упертись у вікно.

# Скільки унікальних прикладів перекладу класти у СПІЛЬНИЙ блок payload.
# Приклади · найважча частина payload (67% байтів), і 77% із них були
# дослівними повторами між рядками пачки. Тепер вони йдуть один раз на всю
# пачку, а це число · стеля на випадок дуже різнорідної пачки. Відкинуте понад
# стелю набір називає у звіті payload, мовчки нічого не зникає.
BDO_SHARED_EXAMPLES=12

# Бюджет на приклади в БАЙТАХ. Відбір іде від КОРОТШИХ: за ті самі байти модель
# бачить більше різних прикладів. Обидві межі діють разом · спрацьовує та, що
# настане раніше.
BDO_EXAMPLES_BUDGET=4000

# Скільки понять гри (`AP` · сила атаки, `Set Effect` · бонус за комплект)
# класти в payload. Це пояснення СЕНСУ, а не відповідники: відповідник дає
# лише глосарій.
BDO_CONCEPTS_MAX=25

# Скільки годин тримати кеш понять, не питаючи API знову. Поняття змінюються
# рідко, тому щопачкові запити були б платою мережею за незмінні дані.
BDO_CONCEPTS_TTL_HOURS=24

# Які шари памʼяті перекладів підставляти в payload як приклади.
# Порожнє значення · шари з пресету режиму (`manual` і `machine`).
# BDO_MEMORY_LAYERS=manual,machine

# =============================================================================
# 4. ПРОГІН
# =============================================================================

# Стеля пачок на ОДИН прогін · запобіжник від нескінченного циклу, а не ліміт
# роботи. Досягнута стеля зупиняє прогін, а не псує стан: наступний запуск
# продовжує з того самого місця.
BDO_RUN_MAX_BATCHES=200

# Мінімальна впевненість судді у відсотках. Нижче цього порога спірний рядок
# іде до людини в модерацію, а не в машинний шар. Журнал рішень ·
# `state/judge-decisions.jsonl`, звіт · `./bdo judge`.
BDO_JUDGE_MIN_CONFIDENCE=70

# Скільки разів драйвер повторює крок, який НЕ рухає стан пачки, перш ніж
# зупинитись із причиною. Захищає лише від холостого циклу: бюджет справжніх
# повторів веде сам рушій.
# BDO_LOOP_SPIN_LIMIT=12

# Вікно й загальний бюджет повторів кроку, який не дав відповіді, у секундах.
# Вікно · як часто пробувати; бюджет · коли здатись і віддати рядок людині.
BDO_CHILD_RETRY_WINDOW_SECONDS=600
BDO_CHILD_RETRY_TOTAL_SECONDS=86400

# Скільки колів лікування проходить рядок із дефектом. Типово одне: смакові
# зауваження QA другим колом майже не рятуються, а коштують хвилин. Рядок із
# наказовою вказівкою API («ужий «Човен» для «Ship»») отримує одну додаткову
# спробу автоматично · для нього «не вилікувалось» означає карантин.
# BDO_HEAL_MAX_ATTEMPTS=1

# Стеля невдалих спроб на ОДИН рядок за всі пачки. Рядок, якому сервер відмовив
# і в шарі, і в модерації, повертався в кожну наступну пачку (один identity
# пройшов конвеєр 21 раз). Після стелі вибірка його не бере, він чекає людину в
# `./bdo quarantine`; `--clear` обнуляє лічильник. 0 вимикає межу.
# BDO_ROW_MAX_ATTEMPTS=2

# Один короткий прохід repair по назвах перед записом, коли фінальна валідація
# каже точно, якої затвердженої назви бракує. off · вимкнути.
# BDO_NAMES_PASS=on

# Короткі ключі r1…rN замість identity_hash у payload і відповіді моделі.
# 0 · показувати моделі повні хеші (лише для порівняння).
# BDO_ROW_ALIAS=1

# Межа робочої сесії агента у хвилинах для `./bdo timer`. На сам переклад не
# впливає · це нагадування людині, скільки вона вже працює.
# BDO_SESSION_BUDGET_MINUTES=300

# =============================================================================
# 5. ЧЕРГА ТЕРМІНІВ
# =============================================================================
#
# Набір може САМ пропонувати описи для термінів глосарія, у яких опису ще
# немає. Правило безпеки: пропозиція можлива ЛИШЕ коли API прямо каже, що поле
# порожнє. Наявний опис і затверджений відповідник не чіпаються ніколи.

# Вмикає автоматичну роботу з чергою термінів: `on` або `off`.
BDO_TERM_NOTES_AUTO=on

# Скільки термінів має накопичитись у черзі, перш ніж набір візьметься за них.
# Менше · частіші дрібні виклики моделі без користі.
BDO_TERM_NOTES_MIN_QUEUE=5

# Скільки термінів брати в один прохід опису.
BDO_TERM_NOTES_BATCH=10

# Мінімальна впевненість моделі у відсотках, щоб опис узагалі надсилався.
# Нижче · пропозиція відкидається мовчки, бо слабкий опис гірший за жоден.
BDO_TERM_NOTES_MIN_CONFIDENCE=60

# Скільки описів максимум надсилати за один прохід. Обмеження навмисне: кожен
# опис перед надсиланням перечитується з API окремим запитом.
BDO_TERM_NOTES_MAX_SEND=3

# =============================================================================
# 6. ПРИБИРАННЯ ДИСКА
# =============================================================================
#
# Робочі файли пачок і відповіді API накопичуються швидко. Прибирання чіпає
# ЛИШЕ похідні файли завершених пачок · нічого, що потрібне для продовження.

# Прибирати автоматично після завершення пачки: 1 · так, 0 · ні.
# Що саме буде прибрано, завжди можна подивитись заздалегідь: ./bdo clean
BDO_AUTO_CLEAN=1

# Скільки ДНІВ тримати теки завершених пачок і дампи `output/`.
BDO_KEEP_DAYS=14

# Скільки останніх квитанцій запису лишати незалежно від віку. Квитанція ·
# доказ того, що саме прийняв сервер, тому кілька останніх тримаємо завжди.
# BDO_KEEP_RECEIPTS=50
