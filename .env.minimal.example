# Мінімальний локальний `.env` для звичайного production-запуску.
# Скопіюйте цей файл у `.env` і вставте власний API key.
# API endpoint PROD береться з вбудованого безпечного default.

BDO_ENV=PROD
BDO_API_KEY_PROD=

# Безплатна модель child-агентів OpenCode Zen.
TRANSLATE_MODEL_PROFILE=session-free
TRANSLATE_MODEL=opencode/x-preview-f-free
TRANSLATE_MODEL_COST=free
BDO_REASONING_EFFORT=none
