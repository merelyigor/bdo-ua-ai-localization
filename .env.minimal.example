# Мінімальний локальний `.env`: рівно те, без чого прогін не почнеться.
# Скопіюйте у `.env` і вставте власний ключ; endpoint PROD · вбудований default.
# Усі інші налаштування мають робочі типові значення · див. `.env.example`.

# Ціль запису. PROD | DEV. Це єдиний дозвіл на запис і єдине джерело адреси.
BDO_ENV=PROD
BDO_API_KEY_PROD=

# Профіль моделей CHILD-агентів (не диригента):
#   ollama-local · локальна Ollama, без оплати за токени · типовий вибір
#   session-free · безкоштовні хмарні маршрути OpenCode Zen
#   session-go   · платна підписка OpenCode Go
#   session-luna · платний openai/gpt-5.6-luna
TRANSLATE_MODEL_PROFILE=ollama-local

# Модель child-агентів. Заміряно 2026-08-28 на M1 Max: 60 рядків EN→UA,
# 20 QA-кейсів, 10 repair, `think=false`.
#   ollama-local/qwen3.6:35b-a3b-mtp-q4_K_M · переклад 97%, 48-52 tok/s,
#     QA 0.90/0.90, repair 90% · ЄДИНА локальна, придатна до ролей QA й судді
#   ollama-local/gemma4:26b-a4b-it-mtp-q4_K_M · переклад 93%, 54 tok/s,
#     QA 0.00/0.00 · лише worker і repair, судити нею не можна
# Повний перелік дозволених маршрутів і хмарні варіанти · `.env.example`.
TRANSLATE_MODEL=ollama-local/qwen3.6:35b-a3b-mtp-q4_K_M

# free · маршрут без окремої оплати за токени
# paid · платний маршрут; профіль мусить його дозволяти
TRANSLATE_MODEL_COST=free
