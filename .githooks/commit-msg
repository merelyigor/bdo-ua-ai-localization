#!/usr/bin/env bash
# Механічна перевірка commit message проти .codex/prompts/commit-message-ua.txt.
#
# Вмикається один раз на клон:
#   git config core.hooksPath .githooks
# Наявність цього налаштування перевіряє `./check-rules.sh`, тому
# «забув увімкнути» перестає бути тихою відмовою.
#
# Навіщо. Правило про формат існувало текстом і покладалось на уважність автора.
# Двічі не спрацювало: у 65 комітів проліз службовий трейлер атрибуції (довелось
# переписувати історію з force-push), а версія `2.10.0` порушила заборону
# двоцифрових компонентів. Обидва випадки ловляться однією перевіркою тут.
#
# Що НЕ перевіряється: зміст опису. Хук не думає замість автора · він лише не
# дає порушити формат, який уже описаний у шаблоні.
#
# VERSION_BASE_REF · від якого коміта рахувати попередню версію (типово HEAD).
# Існує для тестів: так регресію можна прогнати на реальній історії, підставляючи
# кожному коміту його власного батька.
set -uo pipefail

MSG_FILE="${1:?commit-msg hook викликається з шляхом до файла повідомлення}"
BASE_REF="${VERSION_BASE_REF:-HEAD}"

say() { printf 'commit-msg: %s\n' "$1" >&2; }

# Markdown-розмітку нормалізуємо, а не відхиляємо.
#
# Навіщо. Генератори повідомлень в IDE стабільно віддають `**жирний**` і буліти,
# і хук валив коміт цілком · автор мусив правити текст руками при кожному коміті.
# Це та сама природа проблеми, що й з backticks у пункті 3 нижче: перевірка
# відмовляла правильним за суттю повідомленням через форматування. Зміст рядка від
# зняття розмітки не змінюється, тому відхиляти тут нічого. Те, що механічно
# виправити НЕ можна (версія, трейлер атрибуції), як і раніше валить коміт.
#
# Backticks НЕ чіпаємо · вони тут дозволені свідомо (див. пункт 3). Знімаємо рівно
# те, що перевірка забороняє: `**`, буліти, індентовані заголовки й fence-рядки.
# Рядки з `#` у нульовій позиції не чіпаємо · це коментарі git, які в повідомлення
# й так не входять.
#
# `#+` замість `#{1,6}`: інтервальні вирази в реалізаціях awk різняться, а для
# зняття префікса точна кількість решіток значення не має.
normalize_markdown() {
    local tmp
    tmp="$(mktemp)" || return 1
    if ! awk '
        /^#/ { print; next }
        {
            line = $0
            gsub(/\*\*/, "", line)
            if (line ~ /^[[:space:]]*```[[:alnum:]]*[[:space:]]*$/) { line = "" }
            else { sub(/^[[:space:]]*```/, "", line) }
            sub(/^[[:space:]]*#+[[:space:]]+/, "", line)
            sub(/^[[:space:]]*[-*+][[:space:]]+/, "", line)
            print line
        }
    ' "$MSG_FILE" > "$tmp"; then
        rm -f "$tmp"
        return 1
    fi

    if cmp -s "$MSG_FILE" "$tmp"; then
        rm -f "$tmp"
        return 1
    fi

    # cat, а не mv: git тримає шлях до цього файла, тому лишаємо inode і права.
    cat "$tmp" > "$MSG_FILE"
    rm -f "$tmp"
    return 0
}

if normalize_markdown; then
    say 'markdown-розмітку знято автоматично (буліти, заголовки, **жирний**, fence) · текст коміту змінено'
fi

# Коментарі git і порожні хвостові рядки в повідомлення не входять.
body="$(grep -v '^#' "$MSG_FILE" | sed -e :a -e '/^\n*$/{$d;N;};/\n$/ba')"
first="$(printf '%s\n' "$body" | sed -n '1p')"

fail=0

# Технічні коміти git формату не мають і мати не можуть.
case "$first" in
    Merge\ *|Revert\ *|fixup!\ *|squash!\ *|amend!\ *) exit 0 ;;
esac

# 1. Перший рядок · версія з однозначними компонентами.
if ! printf '%s' "$first" | grep -qE '^Версія: [0-9]\.[0-9]\.[0-9]$'; then
    # Дужки навколо імені обовʼязкові: багатобайтовий символ одразу після `$first`
    # bash під `set -u` приймає за частину імені змінної й падає на unbound.
    say "перший рядок мусить бути «Версія: X.Y.Z» з компонентами 0-9. Отримано: [${first}]"
    say "правило: PATCH 9 → MINOR +1, PATCH 0; MINOR і PATCH 9 → MAJOR +1. Компонентів 10, 50, 100 не буває."
    fail=1
fi

# 2. Атрибуція інструмента заборонена (§2 AGENTS.md).
if printf '%s\n' "$body" | grep -qiE '^[A-Za-z][A-Za-z-]*-[Bb]y:|generated with|co-authored'; then
    say "у повідомленні є трейлер або згадка інструмента. Автор комітів · власник."
    printf '%s\n' "$body" | grep -inE '^[A-Za-z][A-Za-z-]*-[Bb]y:|generated with|co-authored' | head -3 >&2
    fail=1
fi

# 3. Markdown-РОЗМІТКА: буліти, заголовки, жирний. Тобто те, що перетворює
#    повідомлення на документ замість речення.
#
#    Backtick НЕ забороняється, хоча раніше забороняався. Причина зміни: у цьому
#    проєкті ідентифікатори (`unresolved`, `./bdo`, `BDO_ENV`) беруться в
#    backticks усюди · у промптах, документації й коментарях, · і в описі коміту
#    це та сама роль лапок, а не форматування. Заборона давала відмову на
#    правильних за суттю повідомленнях: 2026-08-22 два коміти поспіль скасовано
#    рівно через це. Обидва інциденти, через які взагалі зʼявилась ця перевірка
#    (трейлер атрибуції і двоцифрова версія), до backticks стосунку не мають ·
#    їх ловлять пункти 2 і 6.
if printf '%s\n' "$body" | grep -qE '^[[:space:]]*[-*+][[:space:]]|^[[:space:]]*#{1,6}[[:space:]]|\*\*|^[[:space:]]*```'; then
    say "шаблон забороняє markdown-розмітку: буліти, заголовки, **жирний**, блоки коду."
    say "Опис · звичайне речення; файли · простий перелік шляхів, по одному на рядок."
    say "Ідентифікатори в backticks дозволені: «Додано поле \`unresolved\`» це нормально."
    printf '%s\n' "$body" | grep -nE '^[[:space:]]*[-*+][[:space:]]|^[[:space:]]*#{1,6}[[:space:]]|\*\*|^[[:space:]]*```' | head -3 >&2
    fail=1
fi

# 4. Блок «Файли:» обовʼязковий; шаблон дає й дозволений порожній варіант.
if ! printf '%s\n' "$body" | grep -qE '^Файли:$'; then
    say "немає блоку «Файли:». Якщо списку немає, шаблон дозволяє рядок «Немає даних про список файлів у контексті.»"
    fail=1
fi

# 5. Опис по суті між версією і переліком файлів.
desc="$(printf '%s\n' "$body" | sed -n '2,/^Файли:$/p' | grep -v '^Файли:$' | tr -d '[:space:]')"
if [ -z "$desc" ]; then
    say "немає опису: між рядком версії і блоком «Файли:» мусить бути речення по суті зміни."
    fail=1
fi

# 6. Версія мусить зростати. Ловить реальний випадок: після 3.0.0 закомітили
# 2.10.0, і наступний автор версії лишився без однозначної відправної точки.
#
# Обмеження, свідоме: `git commit --amend` із тією самою версією хук пропускає,
# якщо ця версія все одно більша за версію діда. Надійного способу відрізнити
# amend від звичайного коміта в commit-msg hook немає, а ламати amend дорожче,
# ніж лишити цю щілину · від умисного обходу є `--no-verify`.
version_of() {
    git log -1 --format='%B' "$1" 2>/dev/null \
        | sed -n '1{s/^Версія: \([0-9]\)\.\([0-9]\)\.\([0-9]\)$/\1\2\3/p;}'
}

if [ "$fail" -eq 0 ]; then
    new_num="$(printf '%s' "$first" | sed -n 's/^Версія: \([0-9]\)\.\([0-9]\)\.\([0-9]\)$/\1\2\3/p')"
    prev_num="$(version_of "$BASE_REF")"
    if [ -z "$prev_num" ]; then
        say "попередню версію визначити не вдалось ($BASE_REF без рядка «Версія: X.Y.Z») · перевірку зростання пропущено"
    elif [ "$new_num" -gt "$prev_num" ]; then
        :
    else
        prev_dotted="$(printf '%s' "$prev_num" | sed 's/\(.\)\(.\)\(.\)/\1.\2.\3/')"
        grandparent_num="$(version_of "${BASE_REF}^")"
        if [ "$new_num" -eq "$prev_num" ] && [ -n "$grandparent_num" ] && [ "$new_num" -gt "$grandparent_num" ]; then
            say "версія та сама, що в $BASE_REF · вважаю це amend і пропускаю"
        else
            say "версія не зросла: попередня $prev_dotted, нова ${first#Версія: }"
            say "правило: за замовчуванням PATCH +1; PATCH 9 → MINOR +1, PATCH 0; MINOR і PATCH 9 → MAJOR +1"
            fail=1
        fi
    fi
fi

if [ "$fail" -ne 0 ]; then
    say "коміт скасовано. Шаблон: .codex/prompts/commit-message-ua.txt"
    say "обійти свідомо: git commit --no-verify"
    exit 1
fi
exit 0
