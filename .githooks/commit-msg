#!/usr/bin/env bash
# Механічна перевірка commit message проти AGENTS.md §7.
#
# Вмикається один раз на клон:
#   git config core.hooksPath .githooks
# Наявність цього налаштування перевіряє `./check-rules.sh`, тому
# «забув увімкнути» перестає бути тихою відмовою.
#
# Навіщо. Правило про формат існувало текстом і покладалось на уважність автора.
# Двічі не спрацювало: у 65 комітів проліз службовий трейлер атрибуції (довелось
# переписувати історію з force-push), а версія `2.10.0` порушила заборону
# двоцифрових компонентів. Обидва випадки ловляться однією перевіркою тут.
#
# Що НЕ перевіряється: зміст опису. Хук не думає замість автора · він лише не
# дає порушити формат, який уже описаний у шаблоні.
set -uo pipefail

MSG_FILE="${1:?commit-msg hook викликається з шляхом до файла повідомлення}"

# Коментарі git і порожні хвостові рядки в повідомлення не входять.
body="$(grep -v '^#' "$MSG_FILE" | sed -e :a -e '/^\n*$/{$d;N;};/\n$/ba')"
first="$(printf '%s\n' "$body" | sed -n '1p')"

fail=0
say() { printf 'commit-msg: %s\n' "$1" >&2; }

# Технічні коміти git формату не мають і мати не можуть.
case "$first" in
    Merge\ *|Revert\ *|fixup!\ *|squash!\ *|amend!\ *) exit 0 ;;
esac

# 1. Перший рядок · версія з однозначними компонентами.
if ! printf '%s' "$first" | grep -qE '^Версія: [0-9]\.[0-9]\.[0-9]$'; then
    # Дужки навколо імені обовʼязкові: багатобайтовий символ одразу після `$first`
    # bash під `set -u` приймає за частину імені змінної й падає на unbound.
    say "перший рядок мусить бути «Версія: X.Y.Z» з компонентами 0-9. Отримано: [${first}]"
    say "правило: PATCH 9 → MINOR +1, PATCH 0; MINOR і PATCH 9 → MAJOR +1. Компонентів 10, 50, 100 не буває."
    fail=1
fi

# 2. Атрибуція інструмента заборонена (§2 AGENTS.md).
if printf '%s\n' "$body" | grep -qiE '^[A-Za-z][A-Za-z-]*-[Bb]y:|generated with|co-authored'; then
    say "у повідомленні є трейлер або згадка інструмента. Автор комітів · власник."
    printf '%s\n' "$body" | grep -inE '^[A-Za-z][A-Za-z-]*-[Bb]y:|generated with|co-authored' | head -3 >&2
    fail=1
fi

# 3. Markdown, буліти й емодзі шаблон забороняє прямо.
if printf '%s\n' "$body" | grep -qE '^\s*[-*+]\s|^\s*#{1,6}\s|`|\*\*'; then
    say "шаблон забороняє markdown і буліти. Опис · звичайний текст, файли · простий перелік шляхів."
    printf '%s\n' "$body" | grep -nE '^\s*[-*+]\s|^\s*#{1,6}\s|`|\*\*' | head -3 >&2
    fail=1
fi

# 4. Блок «Файли:» обовʼязковий; шаблон дає й дозволений порожній варіант.
if ! printf '%s\n' "$body" | grep -qE '^Файли:$'; then
    say "немає блоку «Файли:». Якщо списку немає, шаблон дозволяє рядок «Немає даних про список файлів у контексті.»"
    fail=1
fi

# 5. Опис по суті між версією і переліком файлів.
desc="$(printf '%s\n' "$body" | sed -n '2,/^Файли:$/p' | grep -v '^Файли:$' | tr -d '[:space:]')"
if [ -z "$desc" ]; then
    say "немає опису: між рядком версії і блоком «Файли:» мусить бути речення по суті зміни."
    fail=1
fi

if [ "$fail" -ne 0 ]; then
    say "коміт скасовано. Формат: AGENTS.md §7"
    say "обійти свідомо: git commit --no-verify"
    exit 1
fi
exit 0
