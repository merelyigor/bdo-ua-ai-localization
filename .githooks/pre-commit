#!/usr/bin/env bash
# Механічний запобіжник проти витоку ключа в публічний репозиторій.
#
# Увімкнути один раз на клон:
#   git config core.hooksPath .githooks
#
# Перевіряє ТІЛЬКИ те, що вже застейджено, і працює на вмісті індексу, а не на
# файлах на диску: інакше `git add` старої версії файла проходив би повз хук.
#
# Три перевірки, кожна з причиною:
#   1. `.env` у коміті. Найпростіший і найчастіший спосіб віддати ключ.
#   2. Значення з локального `.env` усередині будь-якого застейдженого файла.
#      Саме так ключ витікає насправді: не сам файл, а вставлений у README
#      приклад `curl -H "X-API-Key: ..."` зі справжнім ключем.
#   3. Типові патерни чужих секретів (OpenAI, GitHub, AWS, JWT, приватні ключі).
set -uo pipefail

fail=0
say() { printf 'pre-commit: %s\n' "$1" >&2; }

staged="$(git diff --cached --name-only --diff-filter=ACMR)"
[ -n "$staged" ] || exit 0

# 1. Сам файл із ключами.
if printf '%s\n' "$staged" | grep -qxE '(.*/)?\.env'; then
    say "ВІДМОВА: у коміті є .env. Прибери: git rm --cached <файл>"
    fail=1
fi

# 2. Значення з локального .env у застейдженому вмісті.
env_file="${TRANSLATE_ENV_FILE:-.env}"
if [ -f "$env_file" ]; then
    while IFS= read -r line; do
        case "$line" in ''|\#*) continue ;; *=*) ;; *) continue ;; esac
        value="${line#*=}"
        value="${value%\"}"; value="${value#\"}"
        value="${value%\'}"; value="${value#\'}"
        # Короткі й неунікальні значення (порти, url, прапорці) не перевіряємо:
        # вони дали б хибні спрацювання на кожному коміті.
        [ "${#value}" -ge 20 ] || continue
        case "$value" in http*|/*) continue ;; esac
        if git grep -q -F --cached -- "$value" 2>/dev/null; then
            say "ВІДМОВА: значення змінної ${line%%=*} з $env_file знайдено в застейдженому вмісті."
            fail=1
        fi
    done < "$env_file"
fi

# 3. Чужі секрети за формою.
patterns='sk-[A-Za-z0-9]{20,}|gh[pousr]_[A-Za-z0-9]{20,}|AKIA[0-9A-Z]{16}|-----BEGIN [A-Z ]*PRIVATE KEY-----|xox[abpsr]-[A-Za-z0-9-]{10,}'
if git grep -nIE --cached -- "$patterns" 2>/dev/null | head -5 | grep -q .; then
    say "ВІДМОВА: у застейдженому вмісті є щось схоже на секрет:"
    git grep -nIE --cached -- "$patterns" 2>/dev/null | head -5 >&2
    fail=1
fi

if [ "$fail" -ne 0 ]; then
    say "коміт скасовано. Обійти свідомо: git commit --no-verify"
    exit 1
fi
exit 0
