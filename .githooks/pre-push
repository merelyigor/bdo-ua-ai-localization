#!/usr/bin/env bash
# Останній механічний бар'єр проти AI-атрибуції в публічній Git-історії.
# commit-msg ловить проблему під час створення коміту, а цей hook повторно
# перевіряє фактичні commit objects перед push, зокрема після --no-verify,
# rebase, cherry-pick або імпорту комітів з іншого клону.
set -uo pipefail

say() { printf 'pre-push: %s\n' "$1" >&2; }
zero='0000000000000000000000000000000000000000'
fail=0

while read -r local_ref local_sha _remote_ref _remote_sha; do
    [ -n "${local_sha:-}" ] || continue
    [ "$local_sha" != "$zero" ] || continue # deletion

    # Перевіряємо лише коміти, які цей push додає до remote. Старі коміти вже
    # можуть існувати в опублікованій історії; повторно блокувати кожен push
    # через них немає сенсу й це робить remote фактично недоступним.
    if ! git rev-parse --verify "${local_sha}^{commit}" >/dev/null 2>&1; then
        continue # annotated tag не на commit або інший некомітний ref
    fi

    if [ "${_remote_sha:-$zero}" = "$zero" ]; then
        commits="$(git rev-list "$local_sha")"
    else
        commits="$(git rev-list "$local_sha" "^$_remote_sha")"
    fi

    while IFS= read -r commit; do
        [ -n "$commit" ] || continue
        # `CLAUDE.md` у переліку файлів не є атрибуцією. Попередня перевірка
        # шукала `claude` у всьому повідомленні й через це хибно блокувала
        # нормальний push з PhpStorm. Identity перевіряємо окремо, а в тексті
        # ловимо лише справжні trailers/фрази атрибуції на початку рядка.
        identity="$(git show -s --format='%an%n%ae%n%cn%n%ce' "$commit")"
        message="$(git show -s --format='%B' "$commit")"
        if printf '%s\n' "$identity" | grep -qiE 'opus|sonnet|claude|anthropic' \
            || printf '%s\n' "$message" | grep -qiE '^(co-authored-by|generated-by|assisted-by|ai-assisted-by):.*(opus|sonnet|claude|anthropic)|^generated with.*(opus|sonnet|claude|anthropic)'; then
            say "ВІДМОВА: $local_ref містить заборонену AI-атрибуцію в коміті $commit"
            git show -s --format='author=%an <%ae>%ncommitter=%cn <%ce>%nsubject=%s' "$commit" >&2
            fail=1
        fi
    done <<< "$commits"
done

if [ "$fail" -ne 0 ]; then
    say 'push скасовано: очисти author/committer/message; вимикати hook не можна.'
    exit 1
fi
exit 0
