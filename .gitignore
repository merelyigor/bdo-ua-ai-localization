# Ключі API. Публічний репозиторій · сюди вони не потрапляють ніколи.
.env
.env.*
!.env.example
!.env.minimal.example

# Відповіді API і бенчмарки. Каталог створюють самі скрипти (`mkdir -p`).
/output/

# `state/` має власний .gitignore: каталог існує в клоні, а вміст (пачки,
# курсори прогонів) не комітиться. Тут його не дублюємо · інакше маркер теж
# став би невидимим, і клон приїхав би без каталогу.
#
# `state-auto/` ігнорується цілком: це стан замороженого скриптового флоу,
# видаленого 2026-08-22. Локальні файли лишаються на диску, у Git їх немає.
/state-auto/

# Залежності плагіна OpenCode.
node_modules/

# Локальна матеріалізація OpenCode. Канонічні версії лежать у `templates/`,
# `.opencode/templates/` і `.opencode/agent-templates/`; `./bdo env` підставляє
# сюди профіль та модель конкретного користувача.
/opencode.json
/.opencode/translation-models.json
/.opencode/agents/translation-*.md
/.opencode/runtime-model-state.json
/.opencode/runtime-model-state.busy
/.opencode/env-sync-state.json

# macOS
.DS_Store

# IDE
.idea/
.vscode/
