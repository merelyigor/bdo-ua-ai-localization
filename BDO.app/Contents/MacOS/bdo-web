#!/bin/sh
# Місток у набір · без логіки, крім однієї перевірки, яку більше нікому зробити.
#
# Уся робота живе в `cli/system/mac-app.sh`: там її бачать `bash -n`,
# ShellCheck і gate, а всередині бандла вона була б поза перевірками.
#
# ЧОМУ ПЕРЕВІРКА ВСЕ Ж ТУТ. Якщо бандл СКОПІЮВАЛИ кудись інде, набору поруч
# немає · і скрипта, який мав би це пояснити, теж немає. Тоді `exec` дає сирий
# рядок `/bin/bash: … No such file or directory`, якого в Dock ніхто не бачить
# узагалі. Тому пояснення мусить існувати саме тут.
here="$(cd "$(dirname "$0")/../../.." && pwd)"
app="$here/cli/system/mac-app.sh"

if [ ! -f "$app" ]; then
  msg="Набір не знайдено поруч із додатком.

Значок мусить лишатися в теці набору: Dock тримає посилання на оригінал, тому ПЕРЕТЯГУВАТИ його в Dock можна, а копіювати кудись інде · ні.

Шукав тут: $here"
  if command -v osascript >/dev/null 2>&1; then
    osascript -e "display dialog \"$msg\" with title \"BDO Локалізація\" buttons {\"Зрозуміло\"} default button 1" >/dev/null 2>&1
  else
    printf '%s\n' "$msg" >&2
  fi
  exit 1
fi

exec /bin/bash "$app" "$@"
