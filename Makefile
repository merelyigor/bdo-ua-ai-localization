# Один клік для ВИДИМОСТІ роботи, і більше нічого.
#
# Makefile у цьому наборі вже існував і був видалений 2026-09-04 (4.4.0) як
# хвіст попереднього проєкту: він дублював дерево команд, а єдиним джерелом
# цього дерева є `cli/command-registry.json`. Друга копія команд тихо
# розходиться з першою · саме тому її й прибрали.
#
# Тут копії немає й бути не може. Призначення рівно одне: власник одним кліком
# підключається до термінальної сесії, у якій ЗАРАЗ працює агент, і бачить
# кожен крок живими очима. Це неможливо зробити підкомандою `./bdo`: агент
# запускає роботу (`./bdo watch ...`), а підключається до неї ЛЮДИНА зі свого
# терміналу. У PhpStorm кожна ціль має іконку запуску · це і є той клік.
#
# Межу тримає gate: цілей рівно чотири, і жодна не викликає `./bdo` крім
# `watch`. Спроба додати сюди щось із дерева команд валить `./bdo gate shell`.

SESSION ?= bdo

.DEFAULT_GOAL := help
.PHONY: help attach screen stop

help:
	@printf 'Видимість роботи агента у справжньому терміналі (сесія «%s»):\n\n' '$(SESSION)'
	@printf '  make attach   підключитись і дивитись живцем (вийти · Ctrl-b d)\n'
	@printf '  make screen   знімок екрана в цей термінал, без підключення\n'
	@printf '  make stop     зупинити роботу й прибрати сесію\n\n'
	@printf 'Усі команди набору · ./bdo help. Дерево команд живе в\n'
	@printf 'cli/command-registry.json, і Makefile його НЕ дублює.\n'

# `exec` немає: make і так віддає термінал дочірньому процесу, а `attach`
# мусить лишити код виходу tmux, щоб «сесії немає» не читалось як успіх.
attach:
	@tmux has-session -t '$(SESSION)' 2>/dev/null || { \
		printf 'Сесії «%s» немає · агент нічого не запускав або робота вже завершена.\n' '$(SESSION)'; \
		printf 'Подивитись стан без сесії: ./bdo review\n'; \
		exit 1; \
	}
	tmux attach -t '$(SESSION)'

screen:
	@./bdo watch --show

stop:
	@./bdo watch --stop
