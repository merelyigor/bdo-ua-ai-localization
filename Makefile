# Один клік для ВИДИМОСТІ роботи й для запуску інтерфейсу · більше нічого.
#
# Makefile у цьому наборі вже існував і був видалений 2026-09-04 (4.4.0) як
# хвіст попереднього проєкту: він дублював дерево команд, а єдиним джерелом
# цього дерева є `cli/command-registry.json`. Друга копія команд тихо
# розходиться з першою · саме тому її й прибрали.
#
# Тут копії немає й бути не може. Призначень рівно два, і обидва · про КЛІК:
#   1. власник одним кліком підключається до термінальної сесії, у якій зараз
#      працює агент, і бачить кожен крок живими очима. Це неможливо зробити
#      підкомандою `./bdo`: агент запускає роботу (`./bdo watch ...`), а
#      підключається до неї ЛЮДИНА зі свого терміналу;
#   2. власник одним кліком підіймає інтерфейс (`make web`) · у PhpStorm кожна
#      ціль має іконку запуску, і це швидше, ніж шукати термінал.
#
# Межу тримає gate: цілей рівно пʼять, і жодна не викликає `./bdo` крім
# `watch` і `web`. Спроба додати сюди щось із дерева команд валить
# `./bdo gate shell`.

SESSION ?= bdo

.DEFAULT_GOAL := help
.PHONY: help web attach screen stop

help:
	@printf 'Інтерфейс і видимість роботи (сесія «%s»):\n\n' '$(SESSION)'
	@printf '  make web      відкрити інтерфейс у браузері (вільний порт, посилання в терміналі)\n'
	@printf '  make attach   підключитись до роботи агента живцем (вийти · Ctrl-b d)\n'
	@printf '  make screen   знімок екрана в цей термінал, без підключення\n'
	@printf '  make stop     зупинити роботу й прибрати сесію\n\n'
	@printf 'Усі команди набору · ./bdo help. Дерево команд живе в\n'
	@printf 'cli/command-registry.json, і Makefile його НЕ дублює.\n'

# Інтерфейс власника. `./bdo web` сам візьме вільний порт, надрукує посилання й
# відкриє браузер; Ctrl-C зупиняє.
web:
	@./bdo web

# `exec` немає: make і так віддає термінал дочірньому процесу, а `attach`
# мусить лишити власника всередині сесії, а не повернути в make.
attach:
	@tmux attach -t $(SESSION)

screen:
	@./bdo watch --show

stop:
	@./bdo watch --stop
