#!/usr/bin/env bash
# Єдиний вхід у набір. Кожна підкоманда · один наявний скрипт; жодної логіки
# перекладу тут немає й бути не має.
#
#   ./bdo                 згруповане дерево команд
#   ./bdo help flow       порядок команд однієї пачки, рядок за рядком
#   ./bdo <команда> ...    аргументи передаються скрипту без змін
#
# Навіщо. Набір · це 40 файлів `*.sh` в одній теці, і агент, який не знайшов
# штатну команду, писав власну (задокументовано: диригент зібрав items у `php -r`
# і обійшов гейт identity). Одне дерево команд робить штатний шлях коротшим за
# саморобний. Файли навмисно НЕ переміщені: на них посилаються промпти й
# документація, і переміщення · окремий крок із картою перейменувань.
set -euo pipefail

ROOT="$(cd "$(dirname "$0")" && pwd)"
readonly ROOT

die() { printf 'bdo: %s\n' "$1" >&2; exit 2; }

# Надрукувати шапку скрипта · його власну документацію.
#
# Кожен скрипт набору починається блоком `#`-комментарів із призначенням,
# використанням і причинами. Це і є довідка; окремих `--help` скрипти не мають.
# `s/^# //` і `s/^#//` окремими правилами, а не одним із `\?`: BSD sed на macOS
# не знає `\?` у базовому regex, і префікс лишався на місці.
print_header() {
    sed -n '2,/^[^#]/p' "$1" | sed -e '/^[^#]/d' -e 's/^# //' -e 's/^#//'
}

# Запустити скрипт набору, передавши аргументи без змін.
#
# Через `bash`, а не напряму: `select-env.sh` навмисно не має біта виконання (він
# призначений для `source`), і вимагати його тут означало б або зробити файл
# виконуваним без потреби, або втратити команду `bdo env`.
#
# BDO_SHOW_HELP=1 друкує шапку замість запуску. Так `bdo help <команда>` вживає
# ТУ САМУ таблицю відповідностей, що й звичайний виклик · без другої копії, яка
# розійшлася б із першою. Раніше help просто додавав `--help` до аргументів, а
# скрипти такого прапорця не знають: `bdo help fetch` брав `--help` за розмір
# пачки й ішов до API замість друку довідки.
sh_run() {
    local name="$1" script="$ROOT/$1"; shift
    test -f "$script" || die "немає файлу $name"
    if [ "${BDO_SHOW_HELP:-0}" = 1 ]; then
        # Шапка написана в термінах самого файла (`./fetch-rows.sh ...`), тому
        # джерело називається явно · інакше приклади в ній читаються як інша,
        # неіснуюча команда.
        printf 'Довідка скрипта %s (він же реалізує цю підкоманду):\n\n' "$name"
        print_header "$script"
        exit 0
    fi
    exec bash "$script" "$@"
}

usage() {
    cat <<'TXT'
bdo · переклад рядків BDO через Agent API і локальні субагенти

  ./bdo help flow      порядок команд однієї пачки
  ./bdo help <команда> довідка самого скрипта

ПРОГІН І СЕРЕДОВИЩЕ
  env                  яка ціль стоїть у .env (PROD або DEV)
  runtime              контракт локального рантайму перед першою пачкою
  run start|show|end   зафіксувати / показати / зняти ціль прогону
  gate [профіль]       quality gate: preflight docs shell agents runtime api full

ВИБІРКА Й ПАЧКА
  patch                стан патча: скільки лишилось
  fetch                взяти одну пачку рядків з API
  batch run            УВЕСЬ цикл однією командою: вибірка -> переклад -> запис
  batch new|dir|check|end   тека пачки, її шлях, належність файлів, закриття
  subset               підмножина рядків за identity (для repair)
  show                 показати рядки людині
  context              підтверджені приклади для одного рядка

ПІДГОТОВКА ПАЧКИ
  memory find|apply|expand  памʼять перекладів: пошук, застосування, збірка
  glossary gaps|resolve     прогалини глосарію (ВИРОК) і запит терміна
  schema build|qa|clear|show  staged-схема constrained decoding
  payload worker|qa|terminology  компактний payload для субагента
  translate worker|qa|repair     виклик локальної моделі з payload із ДИСКА

ПЕРЕВІРКА Й ЛІКУВАННЯ
  normalize            детерміновані виправлення (латинські гомогліфи)
  items                гейт identity: збірка items із перевіркою source_hash
  russianisms          словниковий детектор русизмів
  validate             валідація на боці API
  heal                 сходинки лікування й payload для repair
  qa-fixes             фільтр виправлень від QA
  merge                накласти виправлення на кандидата

ЗАВЕРШЕННЯ
  commit               PASS у шар, решта в модерацію, збої в карантин
  write                прямий запис у вибраний канал
  moderation           черга модерації: список, approve, reject

ОБСЛУГОВУВАННЯ
  audit                аудит сесій субагентів за базою OpenCode
  audit-dump           повний зріз сесій OpenCode
  profile              профіль моделі: quality | fast | status
  models               звірка моделей із провайдером OpenCode
  bench                вимір локальної моделі на реальній пачці
  clean                ротація тек пачок і output/
  paths                що куди вирішилось із розкладкою
  api                  read-only smoke Agent API
  docker               запуск команди в контейнері проєкту

Скриптовий флоу без чату видалено 2026-08-22 · історія в коміті dac631e
TXT
}

flow() {
    cat <<'TXT'
ПЕРЕКЛАД РОБИТЬСЯ В OPENCODE. Ви говорите з агентом `translation`, а він робить
усю пачку ОДНОЮ командою:

  ./bdo batch run 15 "patch=active&missing=machine"
  ./bdo batch run 15 "missing=machine" --dry           усе, крім запису
  ./bdo batch run 15 "missing=machine" --channel manual

Усередині, по порядку, з нумерацією кроків і названою причиною зупинки:
ціль прогону -> вибірка -> тека пачки -> памʼять -> глосарій -> переклад ->
збірка кандидата -> гейт identity й русизми -> валідація API -> QA -> запис.

Мовний виклик бере payload і схему з ДИСКА, тому «payload не дійшов» неможливий.

--- Окремі команди · лише для розбору збою, не для роботи ------------------

  ./bdo runtime                                     перед ПЕРШОЮ пачкою прогону
  ./bdo env                                         яка ціль стоїть у .env
  ./bdo payload terminology rows.json               -> @translation-terminology
  ./bdo translate worker to-translate.json          переклад напряму
  ./bdo translate qa rows.json clean.json           QA напряму
  ./bdo items rows.json clean.json items.json "" --require-all
  ./bdo validate items.json
  ./bdo commit rows.json clean.json verdicts.json --write
  ./bdo audit                                       правда про сесії

Повна послідовність із причинами · UI_SUBAGENT_WORKFLOW.md
TXT
}

group="${1:-}"
case "$group" in
    ''|help|-h|--help)
        case "${2:-}" in
            '')      usage ;;
            flow)    flow ;;
            *)       BDO_SHOW_HELP=1 exec "$0" "${@:2}" ;;
        esac
        exit 0
        ;;

    # --- прогін і середовище -------------------------------------------------
    env)      sh_run select-env.sh ;;
    runtime)  sh_run check-runtime.sh "${@:2}" ;;
    gate)     sh_run scripts/agent-check.sh "${@:2}" ;;
    run)
        case "${2:-}" in
            start) sh_run run-start.sh "${@:3}" ;;
            show)  sh_run run-start.sh --show ;;
            end)   sh_run run-start.sh --end ;;
            *)     die 'run: потрібно start, show або end' ;;
        esac
        ;;

    # --- вибірка й пачка -----------------------------------------------------
    patch)    sh_run patch-info.sh "${@:2}" ;;
    fetch)    sh_run fetch-rows.sh "${@:2}" ;;
    subset)   sh_run subset-rows.sh "${@:2}" ;;
    show)     sh_run show-rows.sh "${@:2}" ;;
    context)  sh_run row-context.sh "${@:2}" ;;
    batch)
        case "${2:-}" in
            new)   sh_run batch-new.sh "${@:3}" ;;
            dir)   sh_run batch-dir.sh "${@:3}" ;;
            check) sh_run batch-assert.sh "${@:3}" ;;
            end)   sh_run batch-new.sh --end ;;
            run)   sh_run batch-run.sh "${@:3}" ;;
            *)     die 'batch: потрібно run, new, dir, check або end' ;;
        esac
        ;;

    # --- підготовка пачки ----------------------------------------------------
    memory)
        case "${2:-}" in
            find)   sh_run memory-lookup.sh "${@:3}" ;;
            apply)  sh_run memory-apply.sh "${@:3}" ;;
            expand) sh_run memory-expand.sh "${@:3}" ;;
            *)      die 'memory: потрібно find, apply або expand' ;;
        esac
        ;;
    glossary)
        case "${2:-}" in
            gaps)    sh_run glossary-gaps.sh "${@:3}" ;;
            resolve) sh_run glossary-resolve.sh "${@:3}" ;;
            *)       die 'glossary: потрібно gaps або resolve' ;;
        esac
        ;;
    schema)
        case "${2:-}" in
            build) sh_run build-schema.sh "${@:3}" ;;
            qa)    sh_run build-schema.sh --qa "${@:3}" ;;
            clear) sh_run build-schema.sh --clear ;;
            show)  sh_run build-schema.sh --show ;;
            *)     die 'schema: потрібно build, qa, clear або show' ;;
        esac
        ;;
    translate)  sh_run translate.sh "${@:2}" ;;
    payload)
        case "${2:-}" in
            worker)      sh_run worker-payload.sh "${@:3}" ;;
            qa)          sh_run qa-payload.sh "${@:3}" ;;
            terminology) sh_run terminology-payload.sh "${@:3}" ;;
            *)           die 'payload: потрібно worker, qa або terminology' ;;
        esac
        ;;

    # --- перевірка й лікування ----------------------------------------------
    normalize)   sh_run normalize-candidate.sh "${@:2}" ;;
    items)       sh_run build-items.sh "${@:2}" ;;
    russianisms) sh_run check-russianisms.sh "${@:2}" ;;
    validate)    sh_run validate.sh "${@:2}" ;;
    heal)        sh_run heal-plan.sh "${@:2}" ;;
    qa-fixes)    sh_run qa-fixes.sh "${@:2}" ;;
    merge)       sh_run merge-items.sh "${@:2}" ;;

    # --- завершення ----------------------------------------------------------
    commit)     sh_run batch-commit.sh "${@:2}" ;;
    write)      sh_run write-translations.sh "${@:2}" ;;
    moderation) sh_run moderation-queue.sh "${@:2}" ;;

    # --- обслуговування ------------------------------------------------------
    audit)      sh_run verify-run.sh "${@:2}" ;;
    audit-dump) sh_run audit-dump.sh "${@:2}" ;;
    profile)    sh_run set-translation-profile.sh "${@:2}" ;;
    models)     sh_run sync-opencode-models.sh "${@:2}" ;;
    bench)      sh_run model-ab.sh "${@:2}" ;;
    clean)      sh_run batch-clean.sh "${@:2}" ;;
    paths)      sh_run paths.sh "${@:2}" ;;
    api)        sh_run test-api.sh "${@:2}" ;;
    docker)     sh_run run-in-docker.sh "${@:2}" ;;

    *) die "невідома команда '$group'. Дерево команд · ./bdo" ;;
esac
