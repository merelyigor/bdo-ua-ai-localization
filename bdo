#!/usr/bin/env bash
# Єдиний вхід у набір. Кожна підкоманда · один наявний скрипт; жодної логіки
# перекладу тут немає й бути не має.
#
#   ./bdo                 згруповане дерево команд
#   ./bdo help flow       порядок команд однієї пачки, рядок за рядком
#   ./bdo <команда> ...    аргументи передаються скрипту без змін
#
# Єдиний публічний вхід до категоризованої реалізації в `cli/**`. Низькорівневі
# скрипти лишаються внутрішніми деталями, тому оператору не треба знати їх шляхи.
set -euo pipefail

ROOT="$(cd "$(dirname "$0")" && pwd)"
readonly ROOT

die() { printf 'bdo: %s\n' "$1" >&2; exit 2; }

# Надрукувати шапку скрипта · його власну документацію.
#
# Кожен скрипт набору починається блоком `#`-комментарів із призначенням,
# використанням і причинами. Це і є довідка; окремих `--help` скрипти не мають.
# `s/^# //` і `s/^#//` окремими правилами, а не одним із `\?`: BSD sed на macOS
# не знає `\?` у базовому regex, і префікс лишався на місці.
print_header() {
    sed -n '2,/^[^#]/p' "$1" | sed -e '/^[^#]/d' -e 's/^# //' -e 's/^#//'
}

# Запустити скрипт набору, передавши аргументи без змін.
#
# Через `bash`, а не напряму: `cli/system/select-env.sh` навмисно не має біта виконання (він
# призначений для `source`), і вимагати його тут означало б або зробити файл
# виконуваним без потреби, або втратити команду `bdo env`.
#
# BDO_SHOW_HELP=1 друкує шапку замість запуску. Так `bdo help <команда>` вживає
# ТУ САМУ таблицю відповідностей, що й звичайний виклик · без другої копії, яка
# розійшлася б із першою. Раніше help просто додавав `--help` до аргументів, а
# скрипти такого прапорця не знають: `bdo help fetch` брав `--help` за розмір
# пачки й ішов до API замість друку довідки.
sh_run() {
    local name="$1" script="$ROOT/$1"; shift
    test -f "$script" || die "немає файлу $name"
    if [ "${BDO_SHOW_HELP:-0}" = 1 ]; then
        # Шапка написана в термінах самого файла (`./fetch-rows.sh ...`), тому
        # джерело називається явно · інакше приклади в ній читаються як інша,
        # неіснуюча команда.
        printf 'Довідка скрипта %s (він же реалізує цю підкоманду):\n\n' "$name"
        print_header "$script"
        exit 0
    fi
    exec bash "$script" "$@"
}

usage() {
    php -r '
        $r=json_decode((string)file_get_contents($argv[1]),true,512,JSON_THROW_ON_ERROR);
        echo "bdo · переклад рядків BDO через Agent API і субагенти OpenCode\n\n";
        echo "  ./bdo help flow      порядок команд однієї пачки\n  ./bdo help <команда> довідка самого скрипта\n";
        foreach($r["sections"] as $s){echo "\n".(string)$s["title"]."\n";foreach($s["entries"] as $e){printf("  %-38s %s\n",$e[0],$e[1]);}}
        echo "\nРеєстр команд: cli/command-registry.json\n";
    ' "$ROOT/cli/command-registry.json"
}

flow() {
    cat <<'TXT'
ПЕРЕКЛАД РОБИТЬСЯ В OPENCODE. Оберіть primary-режим:

Канонічний реєстр команд: cli/command-registry.json. Gate звіряє його з
dispatcher, execution guard, цим flow і документацією.

  патч          активний патч -> machine
  ручний        ручний шар; складне -> proposal
  пропозиції    усе в модерацію
  покращення-ші    поліпшення наявного machine layer

Режим виконує цикл `./bdo mode start <mode>` -> `./bdo run drive` -> видимий
штатний Task-субагент OpenCode -> `translation_result` -> `./bdo run drive`,
доки вибірка не поверне нуль. Кожну child session можна відкрити в OpenCode.
Перед завершенням: `./bdo gate full && ./bdo api`.

--- Окремі команди · лише для розбору збою, не для роботи ------------------

  ./bdo runtime                                     перед ПЕРШОЮ пачкою прогону
  ./bdo env                                         яка ціль стоїть у .env
  ./bdo payload terminology rows.json               -> @translation-terminology
  ./bdo items rows.json clean.json items.json "" --require-all
  ./bdo validate items.json
  ./bdo heal rows.json clean.json verdicts.json [validate.json]
  ./bdo commit rows.json clean.json verdicts.json --write
  ./bdo audit                                       правда про сесії
  ./bdo session [N] [--errors]                      кроки й відмови диригента

Повна послідовність із причинами · UI_SUBAGENT_WORKFLOW.md
TXT
}

group="${1:-}"
case "$group" in
    ''|help|-h|--help)
        case "${2:-}" in
            '')      usage ;;
            flow)    flow ;;
            *)       BDO_SHOW_HELP=1 exec "$0" "${@:2}" ;;
        esac
        exit 0
        ;;

    # --- прогін і середовище -------------------------------------------------
    # `sh_run` використовує exec для односкриптових команд, тому тут потрібні
    # два звичайні виклики: спочатку ціль/API, потім синхронізація child-моделі.
    env)      bash "$ROOT/cli/system/select-env.sh"; bash "$ROOT/cli/runtime/set-translation-profile.sh" env ;;
    sync)     sh_run cli/runtime/env-sync.sh ;;
    platform) sh_run cli/system/check-platform.sh "${@:2}" ;;
    runtime)  sh_run cli/runtime/check-runtime.sh "${@:2}" ;;
    smoke)    sh_run cli/runtime/prepare-smoke.sh ;;
    gate)     sh_run scripts/agent-check.sh "${@:2}" ;;
    run)
        case "${2:-}" in
            start) sh_run cli/run/run-start.sh "${@:3}" ;;
            show)  sh_run cli/run/run-start.sh --show ;;
            end)   sh_run cli/run/run-start.sh --end ;;
            drive) sh_run cli/run/run-drive.sh "${@:3}" ;;
            *)     die 'run: потрібно start, show, end або drive' ;;
        esac
        ;;
    mode)
        case "${2:-}" in
            status) sh_run cli/run/run-spec.sh status "${3:?mode status потребує режим}" "${4:-active}" "${5:-}" ;;
            start) sh_run cli/run/run-mode.sh "${3:?mode start потребує режим}" "${4:-50}" "${5:-active}" "${6:-}" ;;
            *) die 'mode: потрібно status або start' ;;
        esac
        ;;

    # --- вибірка й пачка -----------------------------------------------------
    patch)    sh_run cli/api/patch-info.sh "${@:2}" ;;
    patches)  sh_run cli/api/patches-overview.sh "${@:2}" ;;
    fetch)    sh_run cli/api/fetch-rows.sh "${@:2}" ;;
    subset)   sh_run cli/batch/subset-rows.sh "${@:2}" ;;
    show)     sh_run cli/api/show-rows.sh "${@:2}" ;;
    context)  sh_run cli/api/row-context.sh "${@:2}" ;;
    batch)
        case "${2:-}" in
            new)   sh_run cli/batch/batch-new.sh "${@:3}" ;;
            dir)   sh_run cli/batch/batch-dir.sh "${@:3}" ;;
            check) sh_run cli/batch/batch-assert.sh "${@:3}" ;;
            end)   sh_run cli/batch/batch-new.sh --end ;;
            *)     die 'batch: потрібно new, dir, check або end' ;;
        esac
        ;;

    # --- підготовка пачки ----------------------------------------------------
    memory)
        case "${2:-}" in
            find)   sh_run cli/prepare/memory-lookup.sh "${@:3}" ;;
            apply)  sh_run cli/prepare/memory-apply.sh "${@:3}" ;;
            expand) sh_run cli/prepare/memory-expand.sh "${@:3}" ;;
            *)      die 'memory: потрібно find, apply або expand' ;;
        esac
        ;;
    glossary)
        case "${2:-}" in
            gaps)    sh_run cli/prepare/glossary-gaps.sh "${@:3}" ;;
            resolve) sh_run cli/api/glossary-resolve.sh "${@:3}" ;;
            *)       die 'glossary: потрібно gaps або resolve' ;;
        esac
        ;;
    schema)
        case "${2:-}" in
            build) sh_run cli/prepare/build-schema.sh "${@:3}" ;;
            qa)    sh_run cli/prepare/build-schema.sh --qa "${@:3}" ;;
            clear) sh_run cli/prepare/build-schema.sh --clear ;;
            show)  sh_run cli/prepare/build-schema.sh --show ;;
            *)     die 'schema: потрібно build, qa, clear або show' ;;
        esac
        ;;
    payload)
        case "${2:-}" in
            worker)      sh_run cli/prepare/worker-payload.sh "${@:3}" ;;
            qa)          sh_run cli/prepare/qa-payload.sh "${@:3}" ;;
            terminology) sh_run cli/prepare/terminology-payload.sh "${@:3}" ;;
            judge)       sh_run cli/prepare/judge-payload.sh "${@:3}" ;;
            *)           die 'payload: потрібно worker, qa, terminology або judge' ;;
        esac
        ;;

    # --- перевірка й лікування ----------------------------------------------
    normalize)   sh_run cli/quality/normalize-candidate.sh "${@:2}" ;;
    items)       sh_run cli/quality/build-items.sh "${@:2}" ;;
    russianisms) sh_run cli/quality/check-russianisms.sh "${@:2}" ;;
    validate)    sh_run cli/api/validate.sh "${@:2}" ;;
    heal)        sh_run cli/heal/heal-plan.sh "${@:2}" ;;
    qa-fixes)    sh_run cli/quality/qa-fixes.sh "${@:2}" ;;
    merge)       sh_run cli/quality/merge-items.sh "${@:2}" ;;

    # --- завершення ----------------------------------------------------------
    commit)     sh_run cli/batch/batch-commit.sh "${@:2}" ;;
    write)      sh_run cli/write/write-translations.sh "${@:2}" ;;
    moderation) sh_run cli/write/moderation-queue.sh "${@:2}" ;;

    # --- обслуговування ------------------------------------------------------
    audit)      sh_run cli/audit/verify-run.sh "${@:2}" ;;
    session)    sh_run cli/audit/session-tail.sh "${@:2}" ;;
    incidents)  sh_run cli/audit/flow-incidents.sh "${@:2}" ;;
    quarantine) sh_run cli/audit/quarantine-report.sh "${@:2}" ;;
    judge)      sh_run cli/audit/judge-report.sh "${@:2}" ;;
    audit-dump) sh_run cli/audit/audit-dump.sh "${@:2}" ;;
    profile)    sh_run cli/runtime/set-translation-profile.sh "${@:2}" ;;
    models)     sh_run cli/runtime/sync-opencode-models.sh "${@:2}" ;;
    bench)      sh_run cli/runtime/model-ab.sh "${@:2}" ;;
    clean)      sh_run cli/batch/batch-clean.sh "${@:2}" ;;
    paths)      sh_run cli/system/paths.sh "${@:2}" ;;
    api)        sh_run cli/api/test-api.sh "${@:2}" ;;

    *) die "невідома команда '$group'. Дерево команд · ./bdo" ;;
esac
