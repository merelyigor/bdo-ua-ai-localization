{
  "version": 1,
  "endpoint": "http://127.0.0.1:11434",
  "provider": "ollama",
  "providers": {
    "ollama": {
      "transport": "ollama",
      "endpoint": "http://127.0.0.1:11434"
    },
    "openai": {
      "transport": "openai",
      "endpoint": "https://api.openai.com/v1",
      "api_key_env": "OPENAI_API_KEY",
      "reasoning_effort": "low"
    }
  },
  "default_model": "qwen3.6:35b-a3b-mtp-q4_K_M",
  "num_ctx": 131072,
  "timeout_seconds": 900,
  "roles": {
    "translation-terminology": {
      "schema": "file:roles/schema/translation-terminology.json",
      "temperature": 0.1
    },
    "translation-worker": {
      "schema": "response",
      "temperature": 0.1
    },
    "translation-qa": {
      "schema": "qa",
      "temperature": 0.1
    },
    "translation-repair": {
      "schema": "response",
      "temperature": 0.1
    },
    "translation-judge": {
      "schema": "file:roles/schema/translation-judge.json",
      "temperature": 0.1
    },
    "translation-glossary": {
      "schema": "file:roles/schema/translation-glossary.json",
      "temperature": 0.1
    },
    "translation-smoke": {
      "schema": "file:roles/schema/translation-smoke.json",
      "temperature": 0.1
    }
  }
}
