{
    "$schema": "https://opencode.ai/config.json",
    "default_agent": "патч",
    "permission": {
        "bash": {
            "*migrate:fresh*": "deny",
            "*migrate:refresh*": "deny",
            "*migrate:reset*": "deny",
            "*db:wipe*": "deny",
            "*migrate:rollback*": "deny"
        },
        "edit": {
            "*/.env": "deny"
        }
    },
    "agent": {
        "build": {
            "disable": true,
            "permission": {
                "task": {
                    "*": "deny",
                    "translation-terminology": "allow",
                    "translation-worker": "allow",
                    "translation-qa": "allow",
                    "translation-repair": "allow",
                    "translation-smoke": "allow"
                }
            }
        },
        "plan": {
            "disable": true,
            "permission": {
                "task": {
                    "*": "deny",
                    "translation-terminology": "allow",
                    "translation-worker": "allow",
                    "translation-qa": "allow",
                    "translation-repair": "allow",
                    "translation-smoke": "allow"
                }
            }
        },
        "general": {
            "disable": true
        },
        "explore": {
            "disable": true
        },
        "translation-terminology": {
            "mode": "subagent",
            "model": "opencode/x-preview-f-free"
        },
        "translation-worker": {
            "mode": "subagent",
            "model": "opencode/x-preview-f-free"
        },
        "translation-qa": {
            "mode": "subagent",
            "model": "opencode/x-preview-f-free"
        },
        "translation-repair": {
            "mode": "subagent",
            "model": "opencode/x-preview-f-free"
        },
        "translation-smoke": {
            "mode": "subagent",
            "model": "opencode/x-preview-f-free"
        },
        "патч": {
            "mode": "primary",
            "permission": {
                "task": {
                    "*": "deny",
                    "translation-terminology": "allow",
                    "translation-worker": "allow",
                    "translation-qa": "allow",
                    "translation-repair": "allow",
                    "translation-smoke": "allow"
                }
            }
        },
        "ручний": {
            "mode": "primary",
            "permission": {
                "task": {
                    "*": "deny",
                    "translation-terminology": "allow",
                    "translation-worker": "allow",
                    "translation-qa": "allow",
                    "translation-repair": "allow",
                    "translation-smoke": "allow"
                }
            }
        },
        "пропозиції": {
            "mode": "primary",
            "permission": {
                "task": {
                    "*": "deny",
                    "translation-terminology": "allow",
                    "translation-worker": "allow",
                    "translation-qa": "allow",
                    "translation-repair": "allow",
                    "translation-smoke": "allow"
                }
            }
        },
        "покращення": {
            "mode": "primary",
            "permission": {
                "task": {
                    "*": "deny",
                    "translation-terminology": "allow",
                    "translation-worker": "allow",
                    "translation-qa": "allow",
                    "translation-repair": "allow",
                    "translation-smoke": "allow"
                }
            }
        }
    },
    "subagent_depth": 1
}
