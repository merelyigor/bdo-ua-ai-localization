parameters:
    level: 0
    # ПЕРЕВІРЯЄТЬСЯ ВЕСЬ РОБОЧИЙ ШЛЯХ, А НЕ ЛИШЕ `lib`.
    #
    # До 2026-09-20 тут стояв самий `lib`, і майже дві тисячі рядків робочого
    # PHP у `cli/**` разом із entrypoint `bdo` не бачила жодна механічна
    # перевірка типів · саме той код, який запускає прогін у власника. Виміряно
    # перед розширенням: на рівні 0 нових помилок нуль, тобто охоплення
    # коштувало нічого, а відсутність охоплення коштувала б першою ж помилкою
    # імені, яку `php -l` не бачить.
    #
    # `bdo` не має розширення `.php`, тому перелічений файлом: за маскою тек
    # PHPStan його не підхопить.
    #
    # `tests/**` і `scripts/**` лишаються поза аналізом свідомо · це оснастка
    # розробки, а не робочий шлях. Склад цього переліку стереже
    # `tests/phpstan-scope.sh`.
    paths:
        - lib
        - cli
        - bdo
