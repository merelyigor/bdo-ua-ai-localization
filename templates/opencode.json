{
    "$schema": "https://opencode.ai/config.json",
    "default_agent": "патч",
    "permission": {
        "bash": {
            "*docker*": "deny",
            "*artisan*": "deny",
            "*mysql*": "deny",
            "*psql*": "deny",
            "*sqlite3*": "deny",
            "*migrate:fresh*": "deny",
            "*migrate:refresh*": "deny",
            "*migrate:reset*": "deny",
            "*db:wipe*": "deny",
            "*migrate:rollback*": "deny"
        },
        "edit": {
            "*/.env": "deny"
        }
    },
    "mcp": {
        "figma-desktop": {
            "enabled": false
        }
    },
    "agent": {
        "title": {
            "prompt": "Ти генератор назв тредів. Виводь ЛИШЕ назву треду, більше нічого.\n\nПравила:\n- рівно один рядок, до 50 символів, без пояснень, лапок і крапки в кінці\n- ЗАВЖДИ українською мовою, навіть якщо повідомлення користувача написане іншою мовою або суржиком\n- ніякої російської: не 'тестов', а 'тестів'; не 'запуска', а 'запуску'\n- технічні терміни, назви файлів, команд, моделей і числа лишай як є\n- не згадуй назви інструментів (read, bash, edit, task)\n- називай суть того, що потрібно користувачу, а не процес"
        },
        "build": {
            "disable": true,
            "permission": {
                "task": {
                    "*": "deny",
                    "translation-terminology": "allow",
                    "translation-worker": "allow",
                    "translation-qa": "allow",
                    "translation-repair": "allow",
                    "translation-smoke": "allow",
                    "translation-judge": "allow"
                }
            }
        },
        "plan": {
            "disable": true,
            "permission": {
                "task": {
                    "*": "deny",
                    "translation-terminology": "allow",
                    "translation-worker": "allow",
                    "translation-qa": "allow",
                    "translation-repair": "allow",
                    "translation-smoke": "allow",
                    "translation-judge": "allow"
                }
            }
        },
        "general": {
            "disable": true
        },
        "explore": {
            "disable": true
        },
        "translation-terminology": {
            "mode": "subagent",
            "model": "ollama-local/qwen3.6:35b-a3b-mtp-q4_K_M"
        },
        "translation-worker": {
            "mode": "subagent",
            "model": "ollama-local/qwen3.6:35b-a3b-mtp-q4_K_M"
        },
        "translation-qa": {
            "mode": "subagent",
            "model": "ollama-local/qwen3.6:35b-a3b-mtp-q4_K_M"
        },
        "translation-repair": {
            "mode": "subagent",
            "model": "ollama-local/qwen3.6:35b-a3b-mtp-q4_K_M"
        },
        "translation-smoke": {
            "mode": "subagent",
            "model": "ollama-local/qwen3.6:35b-a3b-mtp-q4_K_M"
        },
        "патч": {
            "mode": "primary",
            "permission": {
                "task": {
                    "*": "deny",
                    "translation-terminology": "allow",
                    "translation-worker": "allow",
                    "translation-qa": "allow",
                    "translation-repair": "allow",
                    "translation-smoke": "allow",
                    "translation-judge": "allow"
                }
            }
        },
        "ручний": {
            "mode": "primary",
            "permission": {
                "task": {
                    "*": "deny",
                    "translation-terminology": "allow",
                    "translation-worker": "allow",
                    "translation-qa": "allow",
                    "translation-repair": "allow",
                    "translation-smoke": "allow",
                    "translation-judge": "allow"
                }
            }
        },
        "пропозиції": {
            "mode": "primary",
            "permission": {
                "task": {
                    "*": "deny",
                    "translation-terminology": "allow",
                    "translation-worker": "allow",
                    "translation-qa": "allow",
                    "translation-repair": "allow",
                    "translation-smoke": "allow",
                    "translation-judge": "allow"
                }
            }
        },
        "покращення-ші": {
            "mode": "primary",
            "permission": {
                "task": {
                    "*": "deny",
                    "translation-terminology": "allow",
                    "translation-worker": "allow",
                    "translation-qa": "allow",
                    "translation-repair": "allow",
                    "translation-smoke": "allow",
                    "translation-judge": "allow"
                }
            }
        },
        "translation-judge": {
            "mode": "subagent",
            "model": "ollama-local/qwen3.6:35b-a3b-mtp-q4_K_M"
        }
    },
    "subagent_depth": 1
}
